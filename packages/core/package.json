{
  "name": "@80in8/core",
  "version": "0.1.0",
  "description": "Pure TypeScript core for the 80-in-8 mental arithmetic trainer: exact rationals, seeded question generation, identity, scoring and session state.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -b",
    "test": "vitest run --coverage",
    "test:watch": "vitest",
    "mutation": "cd ../.. && node scripts/mutation-smoke.mjs"
  },
  "devDependencies": {
    "@fast-check/vitest": "^0.5.0",
    "@stryker-mutator/core": "^10.0.0",
    "@stryker-mutator/vitest-runner": "^10.0.0",
    "@vitest/coverage-v8": "^5.0.1",
    "fast-check": "^4.10.2",
    "vitest": "^5.0.1"
  }
}
