{
  "name": "80in8-monorepo",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "npm run build -w @80in8/core && npm run build -w @80in8/web",
    "typecheck": "tsc -b packages/core apps/web && tsc --noEmit -p packages/core/tsconfig.test.json",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "test": "npm run test -w @80in8/core && npm run test -w @80in8/web",
    "test:core": "npm run test -w @80in8/core",
    "test:web": "npm run test -w @80in8/web",
    "e2e": "npm run e2e -w @80in8/web",
    "dev": "npm run dev -w @80in8/web",
    "mutation": "node scripts/mutation-smoke.mjs",
    "ci": "npm run lint && npm run typecheck && npm run test && npm run mutation && npm run build",
    "mutation:stryker": "stryker run"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.14",
    "typescript": "^7.0.2"
  }
}
